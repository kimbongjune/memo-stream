{
  "manifest_version": 3,
  "name": "Memo Stream — 채팅형 메모",
  "version": "1.0.0",
  "description": "폴더를 채팅방처럼, 메모를 메시지처럼 쌓는 메모장. 원하면 내 Supabase 프로젝트로 기기 간 동기화도 할 수 있습니다.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "contextMenus",
    "activeTab",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.supabase.com/*",
    "https://*.supabase.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Memo Stream 열기"
  },
  "commands": {
    "capture-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "현재 페이지를 메모로 저장"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
